{
  "spec_version": "0.1-prototype",
  "id": "pvo_branching_demo",
  "title": "Signal / Path",
  "initial_scene": "intro",
  "allowed_domains": [
    "jsonplaceholder.typicode.com"
  ],
  "media": [
    {
      "id": "demo_media",
      "asset_id": "demo_media",
      "name": "media/signal-path.mp4",
      "type": "video/mp4"
    }
  ],
  "playback": {
    "initial_timeline": "timeline_intro",
    "timelines": [
      {
        "id": "timeline_intro",
        "kind": "main",
        "clips": [
          { "id": "clip_intro", "asset_id": "demo_media", "scene": "intro", "start": 0, "end": 6 }
        ]
      },
      {
        "id": "timeline_workshop",
        "kind": "branch",
        "clips": [
          { "id": "clip_workshop", "asset_id": "demo_media", "scene": "workshop", "start": 6, "end": 12 }
        ]
      },
      {
        "id": "timeline_rooftop",
        "kind": "branch",
        "clips": [
          { "id": "clip_rooftop", "asset_id": "demo_media", "scene": "rooftop", "start": 12, "end": 18 }
        ]
      },
      {
        "id": "timeline_ending",
        "kind": "branch",
        "clips": [
          { "id": "clip_ending", "asset_id": "demo_media", "scene": "ending", "start": 18, "end": 24 }
        ]
      }
    ]
  },
  "state": {
    "initial": {
      "path": "unselected",
      "object_tapped": false
    }
  },
  "theme": {
    "accent": "#ffcc33",
    "surface": "#0e1219",
    "text": "#f7f9fc",
    "radius": 14
  },
  "scenes": [
    {
      "id": "intro",
      "label": "01 · Signal",
      "asset_id": "demo_media",
      "parent": null,
      "start": 0,
      "end": 6,
      "on_exit": [
        {
          "type": "show",
          "component": "path_choice"
        }
      ]
    },
    {
      "id": "workshop",
      "label": "02A · Workshop",
      "asset_id": "demo_media",
      "parent": "intro",
      "start": 6,
      "end": 12,
      "on_enter": [
        {
          "type": "show",
          "component": "workshop_card"
        }
      ],
      "next": "ending"
    },
    {
      "id": "rooftop",
      "label": "02B · Rooftop",
      "asset_id": "demo_media",
      "parent": "intro",
      "start": 12,
      "end": 18,
      "on_enter": [
        {
          "type": "show",
          "component": "rooftop_card"
        }
      ],
      "next": "ending"
    },
    {
      "id": "ending",
      "label": "03 · Rejoin",
      "asset_id": "demo_media",
      "parent": "intro",
      "start": 18,
      "end": 24
    }
  ],
  "components": [
    {
      "id": "signal_tip",
      "kind": "tooltip",
      "text": "You found the signal. The video can react without changing its pixels.",
      "presentation": { "scene": "intro", "start": 1, "end": 5.8, "x": 0.5, "y": 0.12, "width": 0.45, "height": 0.1 }
    },
    {
      "id": "intro_card",
      "kind": "card",
      "title": "One MP4. More than one path.",
      "text": "Tap the outlined signal, then choose where the story should go.",
      "presentation": { "scene": "intro", "start": 0.25, "end": 5.8, "x": 0.12, "y": 0.55, "width": 0.76, "height": 0.28 },
      "response_policy": { "dispatch": "interaction", "unanswered": "continue" },
      "actions": []
    },
    {
      "id": "path_choice",
      "kind": "choice",
      "title": "Where should the signal lead?",
      "text": "Both choices are time ranges inside this same MP4.",
      "presentation": { "scene": "intro", "start": 1, "end": 5.8, "x": 0.12, "y": 0.5, "width": 0.76, "height": 0.38 },
      "response_policy": { "dispatch": "layer_end", "unanswered": "pause" },
      "options": [
        {
          "label": "Enter workshop",
          "value": "workshop",
          "actions": [
            {
              "type": "set",
              "key": "path",
              "value": "workshop"
            },
            {
              "type": "goto_scene",
              "scene": "workshop"
            }
          ]
        },
        {
          "label": "Climb to rooftop",
          "value": "rooftop",
          "actions": [
            {
              "type": "set",
              "key": "path",
              "value": "rooftop"
            },
            {
              "type": "goto_scene",
              "scene": "rooftop"
            }
          ]
        }
      ]
    },
    {
      "id": "workshop_card",
      "kind": "card",
      "title": "Workshop path",
      "text": "The player sought to this scene because a data action said goto_scene.",
      "presentation": { "scene": "workshop", "start": 0.2, "end": 5.8, "x": 0.12, "y": 0.58, "width": 0.76, "height": 0.25 },
      "response_policy": { "dispatch": "interaction", "unanswered": "continue" },
      "actions": []
    },
    {
      "id": "rooftop_card",
      "kind": "card",
      "title": "Rooftop path",
      "text": "The player sought to this scene because a data action said goto_scene.",
      "presentation": { "scene": "rooftop", "start": 0.2, "end": 5.8, "x": 0.12, "y": 0.58, "width": 0.76, "height": 0.25 },
      "response_policy": { "dispatch": "interaction", "unanswered": "continue" },
      "actions": []
    },
    {
      "id": "contact_form",
      "kind": "form",
      "title": "Send a note from the video",
      "text": "PVO sends ordinary HTTP. Your server decides what the request means.",
      "submit_label": "Send request",
      "presentation": { "scene": "ending", "start": 2.5, "end": 5.8, "x": 0.1, "y": 0.22, "width": 0.8, "height": 0.62 },
      "response_policy": { "dispatch": "interaction", "unanswered": "pause" },
      "fields": [
        {
          "name": "viewer_name",
          "label": "Your name",
          "type": "text",
          "placeholder": "Ada",
          "required": true
        },
        {
          "name": "viewer_role",
          "label": "I build",
          "type": "choice",
          "options": [
            {
              "label": "Stories",
              "value": "stories"
            },
            {
              "label": "Products",
              "value": "products"
            },
            {
              "label": "Learning",
              "value": "learning"
            }
          ]
        }
      ],
      "on_submit": [
        {
          "type": "request",
          "method": "POST",
          "url": "https://jsonplaceholder.typicode.com/posts",
          "body": {
            "title": "PVO hello from {state.form.contact_form.viewer_name}",
            "body": "I build {state.form.contact_form.viewer_role}",
            "userId": 1
          },
          "into": "responses.contact_form",
          "on_success": [
            {
              "type": "show",
              "component": "request_success",
              "when": {
                "response": "/id",
                "exists": true
              }
            },
            {
              "type": "hide",
              "component": "contact_form"
            }
          ],
          "on_error": [
            {
              "type": "show",
              "component": "request_error"
            }
          ]
        }
      ]
    },
    {
      "id": "request_success",
      "kind": "card",
      "title": "Server replied",
      "text": "The response changed this card. PVO never needed to know what your server does.",
      "presentation": { "scene": "ending", "start": 2.5, "end": 5.9, "x": 0.12, "y": 0.55, "width": 0.76, "height": 0.25 },
      "response_policy": { "dispatch": "interaction", "unanswered": "continue" },
      "actions": []
    },
    {
      "id": "request_error",
      "kind": "card",
      "title": "Request could not connect",
      "text": "The error path is also declared in the file. Try again when you are online.",
      "presentation": { "scene": "ending", "start": 2.5, "end": 5.9, "x": 0.12, "y": 0.55, "width": 0.76, "height": 0.25 },
      "response_policy": { "dispatch": "interaction", "unanswered": "continue" },
      "actions": []
    }
  ],
  "hotspots": [
    {
      "id": "signal_hotspot",
      "label": "Signal object",
      "scene": "intro",
      "start": 1,
      "end": 5.8,
      "x": 0.655,
      "y": 0.245,
      "width": 0.17,
      "height": 0.25,
      "actions": [
        {
          "type": "set",
          "key": "object_tapped",
          "value": true
        },
        {
          "type": "show",
          "component": "signal_tip"
        }
      ]
    }
  ],
  "triggers": [
    {
      "id": "intro_card_at_start",
      "scene": "intro",
      "at": 0.25,
      "actions": [
        {
          "type": "show",
          "component": "intro_card"
        }
      ]
    },
    {
      "id": "form_at_end",
      "scene": "ending",
      "at": 20.5,
      "actions": [
        {
          "type": "show",
          "component": "contact_form"
        }
      ]
    }
  ]
}
