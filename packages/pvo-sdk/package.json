{
  "name": "@pvo/sdk",
  "version": "0.1.0",
  "description": "Read, validate, and pack Playable Video Object files.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./schema": "./pvo-manifest.schema.json",
    "./forms": {
      "types": "./runtime/form-values.d.ts",
      "import": "./runtime/form-values.js"
    },
    "./components": {
      "types": "./manifest/component-values.d.ts",
      "import": "./manifest/component-values.js"
    }
  },
  "types": "./index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@pvo/pvo-animation": "0.1.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts",
    "pvo-manifest.schema.json",
    "README.md",
    "container",
    "manifest",
    "runtime",
    "diagnostics"
  ]
}
